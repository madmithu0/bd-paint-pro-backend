const express = require('express');
const router = express.Router();
const axios = require('axios'); // NBR এবং BTRC পিং করার জন্য

// আপটাইম ট্র্যাকিংয়ের জন্য শুরুর সময়
const startTime = Date.now();

/**
 * GET /routes/health
 * বর্ণনা: হেলথ চেক, NBR ও BTRC পিং, হ্যাকিং অ্যালার্ট এবং আপটাইম মনিটরিং
 */
router.get('/health', async (req, res) => {
    let nbrStatus = 'UP';
    let btrcStatus = 'UP';
    let hackAttemptDetected = false;

    // ১. হ্যাকিং প্রচেষ্টা সনাক্তকরণ (Hack Attempt Alert)
    // উদাহরণস্বরূপ: কোনো ক্ষতিকারক কুয়েরি বা প্যারামিটার থাকলে অ্যালার্ট ট্রিগার হবে
    const sqlInjectionPattern = /['"=\-;]/g;
    const xssPattern = /<script.*?>.*?<\/script>/gi;
    
    const requestData = JSON.stringify(req.query) + JSON.stringify(req.body);
    if (sqlInjectionPattern.test(requestData) || xssPattern.test(requestData)) {
        hackAttemptDetected = true;
        // এখানে আপনি আপনার অ্যালার্ট সিস্টেম বা লগিং যুক্ত করতে পারেন (যেমন: console.error)
    }

    // ২. NBR Ping Check
    try {
        // NBR এর আসল এন্ডপয়েন্ট ইউআরএল এখানে বসাবেন
        await axios.get('https://nbr.gov.bd', { timeout: 3000 });
    } catch (error) {
        nbrStatus = 'DOWN';
    }

    // ৩. BTRC Ping Check
    try {
        // BTRC এর আসল এন্ডপয়েন্ট ইউআরএল এখানে বসাবেন
        await axios.get('https://btrc.gov.bd', { timeout: 3000 });
    } catch (error) {
        btrcStatus = 'DOWN';
    }

    // ৪. Uptime Calculation (সেকেন্ডে)
    const uptimeInSeconds = Math.floor((Date.now() - startTime) / 1000);

    // সিস্টেম ওভারঅল স্ট্যাটাস নির্ধারণ
    const systemStatus = (nbrStatus === 'UP' && btrcStatus === 'UP' && !hackAttemptDetected) ? 'HEALTHY' : 'DEGRADED';

    // রেসপন্স পাঠানো
    res.status(systemStatus === 'HEALTHY' ? 200 : 500).json({
        status: systemStatus,
        uptime: `${uptimeInSeconds} seconds`,
        hackAttemptAlert: hackAttemptDetected,
        dependencies: {
            nbrPing: nbrStatus,
            btrcPing: btrcStatus
        }
    });
});

module.exports = router;
