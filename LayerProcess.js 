const mongoose = require('mongoose');

// ==========================================
// ১. লেয়ার প্রসেস স্কিমা (LayerProcess Schema) ডিজাইন
// ==========================================
const layerProcessSchema = new mongoose.Schema({
    jobId: {
        type: mongoose.Schema.Types.ObjectId,
        ref: 'Job',
        required: true
    },
    mistriId: {
        type: mongoose.Schema.Types.ObjectId,
        ref: 'Mistri',
        required: true
    },
    
    // বর্তমান কাজের লেয়ার ট্র্যাকিং (যেমন: ১ম কোট, ২য় কোট)
    currentLayer: {
        type: Number,
        default: 1,
        min: 1
    },
    totalLayersRequired: {
        type: Number,
        default: 3
    },

    // putty primer check: পুটি এবং প্রাইমার কাজের গুণগত মান যাচাইকরণ (বাধ্যতামূলক)
    puttyPrimerCheck: {
        isPassed: { type: Boolean, default: false },
        inspectedAt: { type: Date },
        inspectorName: { type: String, default: null },
        surfaceMoisturePercentage: { type: Number, default: 0 }, // সারফেসের আর্দ্রতা টেস্ট
        status: { type: String, enum: ['Pending', 'Approved', 'Rejected'], default: 'Pending' }
    },

    // GlamourGuard: দেয়াল বা সারফেসের গ্ল্যামার ও ফিনিশিং সুরক্ষার অতিরিক্ত মেকানিজম
    glamourGuard: {
        isActive: { type: Boolean, default: false },
        coatingType: { type: String, enum: ['Glossy', 'Matte', 'Satin', 'None'], default: 'None' },
        warrantyPeriodYears: { type: Number, default: 0 }, // গ্ল্যামার গার্ডের স্থায়িত্বের ওয়ারেন্টি
        appliedAt: { type: Date }
    },

    // পুরো প্রসেসের বর্তমান কাজের অগ্রগতি
    progressPercentage: {
        type: Number,
        default: 0,
        min: 0,
        max: 100
    },
    status: {
        type: String,
        enum: ['Initialization', 'Putty_Applied', 'Primer_Applied', 'Final_Coating', 'Completed'],
        default: 'Initialization'
    }
}, {
    timestamps: true
});

// ==========================================
// ২. মেথড এবং মিডলওয়্যার (Technical Fault & Gap Free)
// ==========================================

// লেয়ার প্রসেস সেভ বা আপডেট হওয়ার আগে ভ্যালিডেশন চেক
layerProcessSchema.pre('save', function (next) {
    // পুটি ও প্রাইমার চেক পাস না হলে ফাইনাল কোটিং বা গ্ল্যামার গার্ড দেওয়া যাবে না (Business Logic Enforcement)
    if (this.status === 'Final_Coating' || this.glamourGuard.isActive) {
        if (!this.puttyPrimerCheck.isPassed || this.puttyPrimerCheck.status !== 'Approved') {
            return next(new Error('Cannot proceed to Final Coating or activate GlamourGuard without passing the Putty Primer Check.'));
        }
    }
    next();
});

// পরবর্তী লেয়ারে যাওয়ার এবং প্রোগ্রেস আপডেট করার মেথড
layerProcessSchema.methods.advanceToNextLayer = async function (newProgress) {
    if (this.currentLayer >= this.totalLayersRequired) {
        this.status = 'Completed';
        this.progressPercentage = 100;
    } else {
        this.currentLayer += 1;
        this.progressPercentage = Math.min(newProgress, 100);
    }
    return this.save();
};

// ==========================================
// ৩. মডেল এক্সপোর্ট
// ==========================================
const LayerProcess = mongoose.model('LayerProcess', layerProcessSchema);

module.exports = LayerProcess;
