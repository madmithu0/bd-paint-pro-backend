module.exports = {
  apps: [
    {
      name: 'bd-secure-api',
      script: './server.js',
      instances: 'max',
      exec_mode: 'cluster',
      watch: true,
      ignore_watch: ['node_modules', 'logs', '.git'],
      max_restarts: 100,
      restart_delay: 2000,
      min_uptime: '2s',
      listen_timeout: 2000,
      kill_timeout: 2000,
      autorestart: true,
      env: {
        NODE_ENV: 'production',
        PORT: 5000
      }
    }
  ]
};

// অটো-হিলিং ও হেলথ চেক স্ক্রিপ্ট (Health check every 2sec + autoIPBlacklist + hackAutoRestart)
// এটি ব্যাকগ্রাউন্ডে ২ সেকেন্ড পরপর রান করবে এবং কোনো টেকনিক্যাল ফল্ট বা ক্র্যাশ হলে অটো-রিস্টার্ট হুক ট্রিগার করবে
const axios = require('axios');
const { exec } = require('child_process');

setInterval(async () => {
  try {
    const response = await axios.get('http://localhost:5000/routes/health', { timeout: 1500 });
    
    // যদি হেলথ চেকে হ্যাকিং বা ক্ষতিকর কিছু পাওয়া যায়, তবে ক্র্যাশ-টু-রিস্টোর হুক চালু হবে
    if (response.data && response.data.hackAttemptAlert === true) {
      exec('pm2 trigger bd-secure-api hackAutoRestart', (err) => {
        if (!err) console.log('CrashToRestore Hook: System restarted due to security fault.');
      });
    }
  } catch (error) {
    // ২ সেকেন্ড রেসপন্স না পেলে বা ক্র্যাশ করলে অটো-হিলিংয়ের মাধ্যমে ২ সেকেন্ডে রিস্টার্ট হবে
    exec('pm2 restart bd-secure-api', (err) => {
      if (!err) console.log('AutoHealing: Server restarted in 2 seconds after crash detection.');
    });
  }
}, 2000);
