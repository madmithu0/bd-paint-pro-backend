const mongoose = require('mongoose');

// ==========================================
// ১. আনলিমিটেড বিল স্কিমা (UnlimitedBill Schema) ডিজাইন
// ==========================================
const unlimitedBillSchema = new mongoose.Schema({
    billNumber: {
        type: String,
        required: true,
        unique: true,
        trim: true
    },
    jobId: {
        type: mongoose.Schema.Types.ObjectId,
        ref: 'Job',
        required: true
    },

    // estimate: প্রাক্কলন বা প্রাথমিক খরচের হিসাব
    estimate: {
        estimatedAmount: { type: Number, required: true, min: 0 },
        description: { type: String, trim: true }
    },

    // serviceBillLock: সার্ভিস বিল লক মেকানিজম (লক থাকলে এডিট বা রিকালকুলেট করা যাবে না)
    serviceBillLock: {
        isLocked: { type: Boolean, default: false },
        lockedAt: { type: Date },
        lockedBy: { type: String }
    },

    // Mushak NBR invoice: জাতীয় রাজস্ব বোর্ড (NBR) এর নিয়ম অনুযায়ী মূল বিল ও ভ্যাট
    nbrInvoice: {
        mushakChallanNo: { type: String, required: true }, // মূসক চালান নম্বর
        binNumber: { type: String, required: true },       // বিজনেস আইডেন্টিফিকেশন নম্বর
        baseAmount: { type: Number, required: true, min: 0 },
        vatPercentage: { type: Number, default: 15 },      // স্ট্যান্ডার্ড ১৫% ভ্যাট
        vatAmount: { type: Number, default: 0 },
        totalPayable: { type: Number, default: 0 }
    },

    // autoBillPdf: স্বয়ংক্রিয় পিডিএফ জেনারেশন ট্র্যাকিং লিংক ও স্ট্যাটাস
    autoBillPdf: {
        pdfUrl: { type: String, default: null },
        generatedAt: { type: Date },
        isGenerated: { type: Boolean, default: false }
    },

    // noTamper: বিলের ডেটা পরিবর্তন বা জালিয়াতি রোধ করার জন্য সিকিউরিটি হ্যাশ
    noTamper: {
        integrityHash: { type: String, required: true },
        isVerified: { type: Boolean, default: true }
    }
}, {
    timestamps: true
});

// ==========================================
// ২. মেথড এবং মিডলওয়্যার (Technical Fault & Gap Free)
// ==========================================

// বিল সেভ হওয়ার আগে অটোমেটিক NBR ভ্যাট এবং মোট টাকা হিসাব করার প্রি-সেভ মিডলওয়্যার
unlimitedBillSchema.pre('save', function (next) {
    // ১. সার্ভিস বিল লক চেক (লকড থাকলে নতুন করে সেভ বা পরিবর্তন করা যাবে না)
    if (this.serviceBillLock.isLocked && this.isModified()) {
        return next(new Error('This service bill is locked and cannot be modified.'));
    }

    // ২. NBR ভ্যাট এবং মোট টাকা হিসাবকরণ
    this.nbrInvoice.vatAmount = (this.nbrInvoice.baseAmount * this.nbrInvoice.vatPercentage) / 100;
    this.nbrInvoice.totalPayable = this.nbrInvoice.baseAmount + this.nbrInvoice.vatAmount;

    next();
});

// immutable: বিলের নিরাপত্তা নিশ্চিত করতে ডেটাবেজ লেভেলে সরাসরি আপডেট (Update) কুয়েরি ব্লক
unlimitedBillSchema.pre('updateOne', function (next) {
    next(new Error('Bill data is immutable. Direct updates are strictly prohibited.'));
});

unlimitedBillSchema.pre('findOneAndUpdate', function (next) {
    next(new Error('Bill data is immutable. Direct updates are strictly prohibited.'));
});

// বিলটি লক করার মেথড
unlimitedBillSchema.methods.lockBill = async function (adminUser) {
    this.serviceBillLock.isLocked = true;
    this.serviceBillLock.lockedAt = Date.now();
    this.serviceBillLock.lockedBy = adminUser;
    return this.save();
};

// ==========================================
// ৩. মডেল এক্সপোর্ট
// ==========================================
const UnlimitedBill = mongoose.model('UnlimitedBill', unlimitedBillSchema);

module.exports = UnlimitedBill;
