# =========================================================
# SYSTEM & VERSION LOCK (v3.0.0 SELF-HEALING LOCK)
# =========================================================
NODE_ENV=production
PORT=5000
APP_VERSION=v3.0.0
DEV_MODE=false
ENFORCE_CLOUDFLARE=true

# =========================================================
# DATABASE & REDIS CACHE / QUEUE
# =========================================================
MONGO_REPLICA_URI=mongodb://localhost:27017/enterprise_paint_db?replicaSet=rs0
REDIS_URL=redis://127.0.0.1:6379

# =========================================================
# SECURITY, JWT & MONITORING
# =========================================================
JWT_SECRET=replace_with_64_char_ultra_secure_random_secret_key_2026
JWT_REFRESH_SECRET=replace_with_another_64_char_refresh_secret_key_2026
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
HMAC_WEBHOOK_SECRET=replace_with_hmac_sha256_webhook_secret
SENTRY_DSN=

# =========================================================
# SUPER ADMIN SECRET GATE & 4-LAYER BIOMETRIC LOCK
# =========================================================
SUPER_ADMIN_ID=SUPER_OWNER_2026_LOCKED
SUPER_ADMIN_SECRET_ROUTE=/x9-super-2026
SUPER_ADMIN_IP=127.0.0.1
SUPER_ADMIN_PHONE=+8801700000000
SUPER_ADMIN_GMAIL=owner.secret@gmail.com
SUPER_ADMIN_VOICE_HASH=base64_encoded_enrolled_voice_biometric_hash
SUPER_ADMIN_3D_FACE_DATA=base64_encoded_enrolled_3d_face_mesh_vector
OFFLINE_HARDWARE_RECOVERY_KEY=HW-KEY-9988-7766-5544-3322
HIDE_AFTER_MINUTES=5

# =========================================================
# CLOUD STORAGE & BACKUP (AWS S3 / CLOUDFLARE R2 / CLOUDINARY)
# =========================================================
AWS_ACCESS_KEY_ID=your_aws_or_r2_access_key
AWS_SECRET_ACCESS_KEY=your_aws_or_r2_secret_key
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET_NAME=enterprise-paint-backups-bd
CLOUDFLARE_R2_ENDPOINT=
CLOUDINARY_CLOUD_NAME=your_cloudinary_name
CLOUDINARY_API_KEY=your_cloudinary_key
CLOUDINARY_API_SECRET=your_cloudinary_secret

# =========================================================
# BANGLADESH LIVE PAYMENT GATEWAYS (BKASH & NAGAD)
# =========================================================
PAYMENT_MODE=sandbox
BKASH_BASE_URL=https://bka.sh
BKASH_APP_KEY=your_bkash_app_key
BKASH_APP_SECRET=your_bkash_app_secret
BKASH_USERNAME=your_bkash_username
BKASH_PASSWORD=your_bkash_password

NAGAD_BASE_URL=http://mynagad.com
NAGAD_MERCHANT_ID=your_nagad_merchant_id
NAGAD_MERCHANT_NUMBER=01700000000
NAGAD_PUBLIC_KEY=your_nagad_public_key
NAGAD_PRIVATE_KEY=your_nagad_private_key

# =========================================================
# SMS, EMAIL, AI & GOVT COMPLIANCE (BD)
# =========================================================
SMS_GATEWAY_URL=https://sms.net.bd
SMS_API_KEY=your_bd_sms_api_key
SMTP_HOST=://gmail.com
SMTP_PORT=587
SMTP_USER=noreply@yourdomain.com
SMTP_PASS=your_smtp_app_password
FACE_VOICE_API_KEY=your_biometric_verification_api_key
WALL_AI_API_URL=http://127.0.0
NBR_BIN_API_KEY=your_nbr_verification_key
